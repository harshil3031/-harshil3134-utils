    },
    "./date": {
      "types": "./dist/date.d.ts",
      "import": "./dist/esm/date.js",
      "require": "./dist/cjs/date.js"
    },
    "./misc": {
      "types": "./dist/misc.d.ts",
      "import": "./dist/esm/misc.js",
      "require": "./dist/cjs/misc.js"
    },
    "./network": {
      "types": "./dist/network.d.ts",
      "import": "./dist/esm/network.js",
      "require": "./dist/cjs/network.js"
    },
    "./storage": {
      "types": "./dist/storage.d.ts",
      "import": "./dist/esm/storage.js",
      "require": "./dist/cjs/storage.js"
    },
    "./logging": {
      "types": "./dist/logging.d.ts",
      "import": "./dist/esm/logging.js",
      "require": "./dist/cjs/logging.js"
    },
    "./metrics": {
      "types": "./dist/metrics.d.ts",
      "import": "./dist/esm/metrics.js",
      "require": "./dist/cjs/metrics.js"
    },
    "./context": {
      "types": "./dist/context.d.ts",
      "import": "./dist/esm/context.js",
      "require": "./dist/cjs/context.js"
    },
    "./observability": {
      "types": "./dist/observability.d.ts",
      "import": "./dist/esm/observability.js",
      "require": "./dist/cjs/observability.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "import": "./dist/esm/internal.js",
      "require": "./dist/cjs/internal.js"
    },
    "./guards": {
      "types": "./dist/guards.d.ts",
      "import": "./dist/esm/guards.js",
      "require": "./dist/cjs/guards.js"
    },
    "./collection": {
      "types": "./dist/collection.d.ts",
      "import": "./dist/esm/collection.js",
      "require": "./dist/cjs/collection.js"
    },
    "./adapters": {
      "types": "./dist/adapters.d.ts",
      "import": "./dist/esm/adapters.js",
      "require": "./dist/cjs/adapters.js"
    }
