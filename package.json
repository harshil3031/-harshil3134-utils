{
  "name": "@harshil3134/utils",
  "version": "1.0.0",
  "description": "Production-grade TypeScript utility helpers for Node.js, Express, React, and React Native",
  "author": "harshil3134",
  "license": "MIT",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/esm/errors.js",
      "require": "./dist/cjs/errors.js"
    },
    "./validation": {
      "types": "./dist/validation.d.ts",
      "import": "./dist/esm/validation.js",
      "require": "./dist/cjs/validation.js"
    },
    "./async": {
      "types": "./dist/async.d.ts",
      "import": "./dist/esm/async.js",
      "require": "./dist/cjs/async.js"
    },
    "./api": {
      "types": "./dist/api.d.ts",
      "import": "./dist/esm/api.js",
      "require": "./dist/cjs/api.js"
    },
    "./performance": {
      "types": "./dist/performance.d.ts",
      "import": "./dist/esm/performance.js",
      "require": "./dist/cjs/performance.js"
    },
    "./object": {
      "types": "./dist/object.d.ts",
      "import": "./dist/esm/object.js",
      "require": "./dist/cjs/object.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/esm/react.js",
      "require": "./dist/cjs/react.js"
    },
    "./string": {
      "types": "./dist/string.d.ts",
